# Άνοιξε αυτό το αρχείο, συμπλήρωσε τις τιμές και αποθήκευσέ το ως .env
# Χωρίς .env το addon ξεκινά, αλλά δεν έχει ούτε πηγή υποτίτλων ούτε μηχανή
# μετάφρασης — δες τι λείπει με:  npm run check

# --- Διακομιστής ---
PORT=7000
# 127.0.0.1 = μόνο αυτός ο υπολογιστής. Για κινητό στο ίδιο WiFi αργότερα: 0.0.0.0
# (τότε το addon γίνεται ορατό σε όλο το τοπικό δίκτυο — δική σου απόφαση).
BIND_HOST=127.0.0.1
# Μόνο αν θέλεις να δηλώσεις ρητά διεύθυνση (π.χ. https:// μέσω tunnel):
# ADDON_BASE_URL=https://subs.παράδειγμα.gr

# --- Πηγές υποτίτλων (τουλάχιστον ένα) ---
# Δωρεάν κλειδί: https://subdl.com  →  Panel → API  (2000 αναζητήσεις + 50 λήψεις/ημέρα)
SUBDL_API_KEY=

# --- Μετάφραση (τουλάχιστον ένα) ---
# Δωρεάν κλειδί: https://aistudio.google.com/apikey  (δέχεται και το όνομα GOOGLE_API_KEY)
GEMINI_API_KEY=
# Κενό = αυτόματο: το addon διαλέγει το τρέχον μοντέλο flash (η Google αποσύρει μοντέλα)
GEMINI_MODEL=
# Μόνο αν χρησιμοποιείς άλλο endpoint (proxy / άλλη περιοχή):
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Χρονικό όριο ανά αίτημα (ms). Μεγαλύτερο για αργά μοντέλα, μικρότερο για πιο
# γρήγορη πτώση στο τοπικό LM Studio.
GEMINI_TIMEOUT_MS=90000

# Τοπικό μοντέλο μέσω LM Studio (εφεδρεία, προαιρετικό)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=

# --- Γλώσσα ---
TARGET_LANG=el
TARGET_LANG_NAME=Ελληνικά
SOURCE_LANGS=en

# --- Σειρά προτίμησης ---
# (το opensubtitles έρχεται σε επόμενη φάση — ό,τι δεν υπάρχει απλώς αγνοείται)
PROVIDER_ORDER=subdl
ENGINE_ORDER=gemini,lmstudio

# --- Λεπτομέρειες ---
# Πόσα cues ανά αίτημα μετάφρασης (μικρότερο = πιο ασφαλές, περισσότερα αιτήματα)
TRANSLATE_BATCH_SIZE=70
# Κάτω από αυτό το match_score ο υπότιτλος απορρίπτεται ως λάθος release
SUBDL_MIN_MATCH_SCORE=0.8
CACHE_DIR=./cache
GLOSSARY_FILE=./glossary.json
